#!/bin/sh
# Gate pushes to main: public-text check, rustfmt and clippy with the CI flags.
# Other branches are not gated. Bypass once with --no-verify (sparingly).
push_to_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in refs/heads/main) push_to_main=1 ;; esac
done
[ "$push_to_main" -eq 1 ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
PKGS="-p unisolver-core -p unisolver-synth -p unisolver-cabi -p namesgen -p solvecli -p xtask"
if [ -f scripts/ci/check_public_text.py ]; then
  python3 scripts/ci/check_public_text.py || exit 1
fi
cargo fmt $PKGS -p unisolver_frb -- --check || { echo "pre-push: run cargo fmt" >&2; exit 1; }
cargo clippy $PKGS --all-targets --features "imageio satellites" -- -D warnings || exit 1
# Maintainers link the internal tree, which lints itself
if [ -x internal/scripts/ci.sh ]; then
  internal/scripts/ci.sh --lint || exit 1
fi
