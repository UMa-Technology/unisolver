From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: unisolver <patches@unisolver.invalid>
Date: Sun, 4 Oct 2026 15:52:56 +0800
Subject: [PATCH] optional data paths


diff --git a/seiza/Cargo.toml b/seiza/Cargo.toml
index c8dd23aeebf69e860ab8616b83ef0c01e8000a18..0cacee5776ddc56176bd9d2eed00587143f20779 100644
--- a/seiza/Cargo.toml
+++ b/seiza/Cargo.toml
@@ -12,7 +12,7 @@ keywords = ["astronomy", "astrophotography", "plate-solving", "wcs", "astrometry
 categories = ["science", "multimedia::images"]
 
 [dependencies]
-directories = "6"
+directories = { version = "6", optional = true }
 image = { version = "0.25", default-features = false, features = ["png", "jpeg"] }
 thiserror = "2"
 seiza-calibration = { path = "../seiza-calibration", version = "0.4.2" }
@@ -27,5 +27,12 @@ serde_json = "1"
 postcard = { version = "1", features = ["use-std"] }
 sha2 = "0.11"
 
+[features]
+default = ["data-paths"]
+# Default catalog locations (`data_paths`): the platform data directories `seiza setup`
+# installs into. Embedders that always pass their own paths can leave it out, and with it
+# the `directories` dependency tree.
+data-paths = ["dep:directories"]
+
 [dev-dependencies]
 tempfile = "3"
diff --git a/seiza/src/lib.rs b/seiza/src/lib.rs
index 043ee0c0d024e88cc4e3eb6d906b988fb8a5060c..921e9438fde989f9059e5b7e10600ed052ceb6b5 100644
--- a/seiza/src/lib.rs
+++ b/seiza/src/lib.rs
@@ -10,6 +10,7 @@
 
 pub mod blind;
 pub mod catalog;
+#[cfg(feature = "data-paths")]
 pub mod data_paths;
 pub mod detect;
 pub mod minor_bodies;
