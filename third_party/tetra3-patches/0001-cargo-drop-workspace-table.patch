From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: unisolver <patches@unisolver.invalid>
Date: Sun, 27 Sep 2026 21:54:09 +0800
Subject: [PATCH] cargo: drop workspace table

Upstream lists itself and python/ as a workspace. A package with its own
[workspace] table cannot be a member of another workspace, and python/ is
not vendored.

diff --git a/Cargo.toml b/Cargo.toml
index 3d254e42199da15421b72b6be7ffe123e210cc32..2528c341ea2df147802ed70ad83794c95303fbc9 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,6 +1,3 @@
-[workspace]
-members = [".", "python"]
-
 [package]
 keywords = [
     "star-plate-solver",
